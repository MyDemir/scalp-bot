# Binance API (Futures için gerekli)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# İsteğe bağlı: ayar/susturma yetkisi olan Telegram kullanıcı ID'leri (virgüllü, /benkimim ile öğrenilir).
# Tanımlı değilse grubun yöneticileri yetkilidir.
# TELEGRAM_ADMIN_IDS=123456789

# İsteğe bağlı: kartlardaki saat dilimi (varsayılan Europe/Istanbul)
# DISPLAY_TZ=Europe/Istanbul
